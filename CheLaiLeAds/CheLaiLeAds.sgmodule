#!name=车来了净化 · Surge 原生版
#!desc=保留完整底栏、推广、跟踪净化；Surge Mac 5.9.0+ / iOS 5.14.0+。
#!author=nympheon；上游 ddgksf2013
#!homepage=https://github.com/nympheon/My-Surge-Module
#!category=去广告
# Source: ddgksf2013/Rewrite/AdBlock/CheLaiLeAds.cof; frozen 2026-10-31.

[URL Rewrite]
# S0022 | 我的推广
^https?:\/\/.*chelaile\.net\.cn\/goocity\/flowPos\/listByPos - reject

[Map Local]
# S0024 | 详情页
^https?:\/\/cdn\.web\.chelaile\.net\.cn\/info-flow\/index\.html data-type=text data=""
# S0026 | 通用广告
^https?:\/\/.*chelaile\.net\.cn\/(api\/)?adpub data-type=text data=""
# S0028 | IP 广告
^https?:\/\/124\.70\.194\.16\/(ip|adpub) data-type=text data=""
# S0030 | IP 我的推广
^https?:\/\/124\.70\.194\.16\/goocity\/flowPos\/listByPos data-type=text data=""
# S0034 | 公交详情
^https?:\/\/web\.chelaile\.net\.cn\/api\/operative_position\/infoflow data-type=text data=""
# S0036 | 跟踪
^https?:\/\/atrace\.chelaile\.net\.cn\/(wx_preloadAd|adAnalysis) data-type=text data=""

[Script]
# S0032 | YGKJ 底栏：保留包装、原始字节与数字精度
CheLaiLe-City = type=http-response,pattern=^https?:\/\/.*chelaile\.net\.cn\/goocity\/city!,script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/CheLaiLeAds/js/chelaile.js,requires-body=true,max-size=1048576,timeout=5

[MITM]
hostname = %APPEND% web.chelaile.net.cn, api.chelaile.net.cn, cdn.api.chelaile.net.cn, cdn.web.chelaile.net.cn, atrace.chelaile.net.cn, 124.70.194.16
