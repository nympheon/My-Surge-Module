[URL Rewrite]
# 斗鱼：把内嵌 CDN 主机的 HTTP IP 地址重定向回原始主机，保留路径。
^http://(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)/(hlsh5p1\.douyucdn2\.cn)(.*) http://$1$2 307
# QQ 链接重定向：从 Loon 条件重写逐条改为原生 307；使用原捕获组，去掉包装跟踪参数。
(?i)^https://c\.pc\.qq\.com/middlem\.html\?pfurl=(http.*)&pfuin=.* $1 307
(?i)^https://c\.pc\.qq\.com/middlect\.html\?pfuin=.*&pfurl=(http.*)&gjsublevel=.* $1 307
(?i)^https://c\.pc\.qq\.com/middlect\.html\?iscontinue=.*pfurl=(http.*)&pfuin=.* $1 307
(?i)^https://pingtas\.qq\.com/webview/pingd\?dm=c\.pc\.qq\.com&pvi=\d+&si=s\d+&url=/middlem\.html\?pfurl%3d(http.*)%26pfuin%3d.*%26pfuin%3d.* $1 307
(?i)^https://cgi\.connect\.qq\.com/qqconnectopen/get_urlinfoForQQV2\?url=(http.*) $1 307
(?i)^https://c\.pc\.qq\.com/index\.html\?pfurl=(http.*)&pfuin=.* $1 307
(?i)^https://c\.pc\.qq\.com/ios\.html\?url=(http.*)&level=.* $1 307
(?i)^https://pingtas\.qq\.com/webview/pingd\?dm=c\.pc\.qq\.com&pvi=\d+&si=s\d+&url=/ios\.html\?url%3d(http.*)%26level.*%26level.* $1 307

[Script]
# 请求阶段只检查头部，不读取正文。
Kelee-12306 = type=http-request, pattern=^https://mobile\.12306\.cn/otsmobile/app/mgs/mgw\.htm$, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/kelee/js/12306_remove_ads.js, timeout=5
Kelee-Umetrip = type=http-request, pattern=(?i)^https?://(?:114\.115\.217\.129|home\.umetrip\.com)/gateway/api/umetrip/native$, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/kelee/js/Umetrip_remove_ads.js, timeout=5
# Protobuf 必须以二进制模式处理；参数直接传 true/false，不额外嵌入引号。
Kelee-TiebaProto = type=http-response, pattern=(?i)^https?://tiebac?\.baidu\.com/c/(?:f/excellent/personalized|f/frs/page|b/ad/adBid|f/ad/getFeedAd|f/pb/page|f/frs/generalTabList)\?(?:[^#?&]+&)*cmd=\d+&format=protobuf, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/kelee/js/tieba-proto.js, requires-body=true, binary-body-mode=true, timeout=10, argument=per_filter_video_thread={{{Tieba_FilterVideo}}}
Kelee-NetEaseGodlike = type=http-response, pattern=(?i)^https://app-conf\.ds\.163\.com/v1/app/base/conf/static/start-config\?(?:[^#?&]+&)*os=ios, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/kelee/js/NetEaseGodlike_remove_ads.js, requires-body=true, timeout=10
Kelee-JD = type=http-response, pattern=(?i)^https://api\.m\.jd\.com/client\.action\?(?:[^#?&]+&)*functionId=(?:deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome), script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/kelee/js/JD_remove_ads.js, requires-body=true, timeout=10
Kelee-PinDuoDuo = type=http-response, pattern=(?i)^https://m\.pinduoduo\.net/mdkd/package\?(?:[^#?&]+&)*from_app_scan, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/kelee/js/PinDuoDuo_remove_ads.js, requires-body=true, timeout=10
# 小红书按同一脚本合并互斥 URL，避免重复的脚本名覆盖。
Kelee-RedPaper = type=http-response, pattern=(?i)^https://(?:(?:edith\.xiaohongshu\.com/api/sns/(?:v1/(?:note/(?:imagefeed|live_photo/save)|system/service/ui/config\?|system_service/config\?|interaction/comment/video/download)|v2/(?:system_service/splash_config|note/widgets|user/followings/followfeed|note/feed)|v3/note/videofeed|v4/followfeed\?|v5/(?:recommend/user/follow_recommend\?|note/comment/list)))|(?:(?:edith|rec)\.xiaohongshu\.com/api/sns/v6/homefeed\?)|(?:(?:edith|so)\.xiaohongshu\.com/api/sns/v10/search/notes\?)|(?:(?:edith|rec|www)\.xiaohongshu\.com/api/sns/(?:v4/note/videofeed|v10/note/video/save))), script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/kelee/js/RedPaper_remove_ads.js, requires-body=true, timeout=10
Kelee-Taobao = type=http-response, pattern=(?i)^https://(?:guide-acs\.m\.taobao\.com/gw/mtop\.taobao\.(?:cloudvideo\.video\.query|wireless\.home\.splash\.awesome\.get)|poplayer\.template\.alibaba\.com/\w+\.json), script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/kelee/js/Taobao_remove_ads.js, requires-body=true, timeout=10
Kelee-Caixin = type=http-response, pattern=(?i)^https://(?:entities\.caixin\.com/api/dataplus/columns|gateway\.caixin\.com/api/(?:app-api/(?:caixinapp/appinfo|search/getkeyword)|app-content/fm/index/list\?)|gg\.caixin\.com/s\?(?:[^#?&]+&)*z=caixin&op=\d|mappsv5\.caixin\.com/articlev5/\d+/\d+\.json$|mapps?v5\.caixin\.com/(?:channelv5/list|/?index_page_v5/)\w+), script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/kelee/js/CaixinMedia_remove_ads.js, requires-body=true, timeout=10
Kelee-BaiduHome = type=http-response, pattern="(?i)^https?://(?:www|m)\.baidu\.com/?(?:$|\?(?:[^#?&]+&)*from=\w{8,9})", script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/kelee/js/BaiduSearchHomePage_remove_ads.js, requires-body=true, timeout=10
Kelee-WeixinLinks = type=http-response, pattern=(?i)^https://(?:weixin110\.qq|security\.wechat)\.com/cgi-bin/mmspamsupport-bin/newredirectconfirmcgi\?, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/kelee/js/Weixin_external_links_unlock.js, requires-body=true, timeout=15

