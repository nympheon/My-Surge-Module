#!name=kelee
#!desc=手工整合已选 54 项去广告及微信、QQ 外链功能，采用 Surge 原生拦截、Map Local 和 JQ；所需脚本和静态资源由本仓库下载并缓存。
#!author=可莉及原插件作者；Surge 手工转换、优化与合并
#!arguments=Tieba_FilterVideo:true,IThome_RemovePinned:false,IThome_RemoveBanners:false
#!arguments-desc=Tieba_FilterVideo：是否过滤贴吧推荐视频帖；IThome_RemovePinned：是否移除 IT之家置顶文章；IThome_RemoveBanners：是否移除 IT之家全部横幅。均填写 true 或 false。

# 来源：当前 57 项清单中除独立 HTTPDNS 拦截、京东比价和 YouTube 之外的 54 项。
# 核对镜像：bunizao/Mirrored，a8e1cbf97a2298a5f64412fcd1c6deb11d5de4f6。
# 需要支持原生 JQ 正文重写的 Surge（iOS 5.14+ / Mac 5.9+）。
# 原插件需要的 HTTPS 解密域名统一追加，不覆盖用户已有 MITM 列表。

[Rule]
# 广告平台拦截器：先保留原有例外，再处理广告与统计平台。
DOMAIN-KEYWORD,adstrategy,REJECT
AND,((DOMAIN-KEYWORD,tnc),(OR,((DOMAIN-SUFFIX,capcutapi.com),(DOMAIN-SUFFIX,zijieapi.com),(DOMAIN-SUFFIX,isnssdk.com),(DOMAIN-SUFFIX,toutiaoapi.com),(DOMAIN-SUFFIX,bytedance.com),(DOMAIN-SUFFIX,snssdk.com),(DOMAIN-SUFFIX,sgsnssdk.com)))),DIRECT
AND,((DOMAIN-KEYWORD,-ad-),(DOMAIN-SUFFIX,byteimg.com)),REJECT
AND,((DOMAIN-KEYWORD,ads),(DOMAIN-KEYWORD,-normal.zijieapi.com)),REJECT
# 短信验证码、号码验证例外，必须位于 mob.com / jiguang.cn 拦截之前。
DOMAIN,init.sms.mob.com,DIRECT
