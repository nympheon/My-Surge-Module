http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/search\.v\d\.Search\/GetHotSearch 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.comics | type) == "array" then .data.comics=[] else . end'
# S0077 | 红点
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/line\.v\d\.Line\/TabRedDot 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.has_red_dot | type) == "boolean" then .data.has_red_dot=false else . end'
# S0080 | 推荐
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Recommend 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "array" then .data=[] else . end'
# @source CainiaoAds
# S0022 | 我的页：按原 truthy 条件删除推广/资产/钱包
http-response-jq ^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch '. as $original | try (def ok: type=="object" and (any(.ret[]?;type=="string" and startswith("FAIL_"))|not) and ([.error,.errorMessage]|all(.==null or .==false or .=="")); if ok and (.data|type)=="object" and (.data.data|type)=="object" then .data.data |= with_entries(select(((.key=="banner" or .key=="activity" or .key=="asset" or .key=="vip" or .key=="wallet") and .value!=null and .value!=false and .value!=0 and .value!="")|not)) else . end) catch $original'
# S0024 | 合并首页：仅处理原 0..3 子响应，子响应失败也透传
http-response-jq ^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.nbpresentation\.homepage\.merge\.get\.cn '. as $original | try (def ok: type=="object" and (any(.ret[]?;type=="string" and startswith("FAIL_"))|not) and ([.error,.errorMessage]|all(.==null or .==false or .=="")); if ok and (.data|type)=="object" then .data |= with_entries(if (.key|test("^mtop\\.cainiao\\.nbpresentation\\.protocol\\.homepage\\.get\\.cn@[0-3]$")) and (.value|ok) and (.value.data.result.dataList|type)=="array" and all(.value.data.result.dataList[];type=="object" and (.type|type)=="string") then .value.data.result.dataList |= map(select(.type!="big_banner_area_v870" and .type!="todo_list_v860")) else . end) else . end) catch $original'
# S0026 | 首页惊喜福利与待办区
http-response-jq ^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.nbpresentation\.protocol\.homepage\.get\.cn '. as $original | try (def ok: type=="object" and (any(.ret[]?;type=="string" and startswith("FAIL_"))|not) and ([.error,.errorMessage]|all(.==null or .==false or .=="")); if ok and (.data|type)=="object" and (.data.result|type)=="object" and (.data.result.dataList|type)=="array" and all(.data.result.dataList[];type=="object" and (.type|type)=="string") then .data.result.dataList |= map(select(.type!="big_banner_area_v870" and .type!="todo_list_v860")) else . end) catch $original'
# S0028 | 搜索推荐词
http-response-jq ^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.adkeyword '. as $original | try (def ok: type=="object" and (any(.ret[]?;type=="string" and startswith("FAIL_"))|not) and ([.error,.errorMessage]|all(.==null or .==false or .=="")); if ok and (.data|type)=="object" and (.data.result|type)=="object" and .data.result.adHotKeywords!=null and .data.result.adHotKeywords!=false and .data.result.adHotKeywords!=0 and .data.result.adHotKeywords!="" then .data.result.adHotKeywords=[] else . end) catch $original'
# @source GoofishAds
# S0027 | 悬浮球
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idle.user.strategy.list 'if type == "object" and (any(.ret[]?; type == "string" and startswith("FAIL_")) | not) and (.data | type) == "object" and (.data.strategies | type) == "array" then .data.strategies=[{}] else . end'
# S0031 | 首页顶部 Tab
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idlehome.home.circle.list 'if type == "object" and (any(.ret[]?; type == "string" and startswith("FAIL_")) | not) and (.data | type) == "object" and (.data.circleList | type) == "array" and all(.data.circleList[]; type == "object" and (.bizCode | type) == "string") then .data.circleList |= map(select(.bizCode != "saveMoney")) else . end'
# S0033 | 首页仅保留第一顶部项与商品信息流
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idlehome.home.nextfresh 'if type == "object" and (any(.ret[]?; type == "string" and startswith("FAIL_")) | not) and (.data | type) == "object" and (.data.homeTopList | type) == "array" and (.data.sections | type) == "array" and all(.data.sections[]; type == "object" and (.data | type) == "object" and (.data.bizType | type) == "string") then .data.homeTopList |= [.[0]] | .data.sections |= map(select(.data.bizType == "item")) else . end'
# S0035 | 搜索填词
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idlemtopsearch.search.shade 'if type == "object" and (any(.ret[]?; type == "string" and startswith("FAIL_")) | not) and (.data | type) == "object" and (.data.singleShadeWords | type) == "array" then .data.singleShadeWords=[{}] else . end'
# S0037 | 猜你可能找
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idlemtopsearch.item.search.activate 'if type == "object" and (any(.ret[]?; type == "string" and startswith("FAIL_")) | not) and (.data | type) == "object" and (.data.cardList | type) == "array" then .data.cardList=[{}] else . end'
# S0039 | 搜索发现
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idlemtopsearch.search.discover 'if type == "object" and (any(.ret[]?; type == "string" and startswith("FAIL_")) | not) and (.data | type) == "object" and (.data.resultList | type) == "array" then del(.data.resultList) else . end'
# S0041 | 我的页保留 head/user/trade 正则分支
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.idle.user.page.my.adapter 'if type == "object" and (any(.ret[]?; type == "string" and startswith("FAIL_")) | not) and (.data | type) == "object" and (.data.ability | type) == "array" and (.data.container | type) == "object" and (.data.container.sections | type) == "array" and all(.data.container.sections[]; type == "object" and (.sectionBizCode | type) == "string") then .data.ability=[] | .data.container.sections |= map(select(.sectionBizCode | test("head|user|trade"))) else . end'
# S0043 | 我的页购买推荐流
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idle.item.buy.feeds 'if type == "object" and (any(.ret[]?; type == "string" and startswith("FAIL_")) | not) and (.data | type) == "object" and (.data.sections | type) == "array" then del(.data.sections) else . end'
# S0045 | 本地仅保留商品流
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idle.local.home 'if type == "object" and (any(.ret[]?; type == "string" and startswith("FAIL_")) | not) and (.data | type) == "object" and (.data.sections | type) == "array" and all(.data.sections[]; type == "object" and (.data | type) == "object" and (.data.bizType | type) == "string") then .data.sections |= map(select(.data.bizType == "item")) else . end'
# S0047 | 搜索结果仅保留商品；原来的宽路径正则保留
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idlemtopsearch.search 'if type == "object" and (any(.ret[]?; type == "string" and startswith("FAIL_")) | not) and (.data | type) == "object" and (.data.resultList | type) == "array" and all(.data.resultList[]; type == "object" and (.data | type) == "object" and (.data.item | type) == "object" and (.data.item.main | type) == "object" and (.data.item.main.clickParam | type) == "object" and (.data.item.main.clickParam.args | type) == "object" and (.data.item.main.clickParam.args.biz_type | type) == "string") then .data.resultList |= map(select(.data.item.main.clickParam.args.biz_type == "item")) else . end'
# S0049 | 商品底部剔除 mamaAD
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idle.item.recommend 'if type == "object" and (any(.ret[]?; type == "string" and startswith("FAIL_")) | not) and (.data | type) == "object" and (.data.cardList | type) == "array" and all(.data.cardList[]; type == "object" and (.cardData | type) == "object" and (.cardData.bizType | type) == "string") then .data.cardList |= map(select(.cardData.bizType != "mamaAD")) else . end'
# @source MoJiWeatherAds
# S0021 | 我的页面移除工具区、我页面灯泡、banner区
http-response-jq ^https?:\/\/.*api\.moji\.com\/json\/entrance\/list 'if type == "object" and (.entrance_region_res_list | type) == "array" and all(.entrance_region_res_list[]; type == "object" and (.region_name | type) == "string") then .entrance_region_res_list |= map(select(.region_name | IN("工具区", "我页面灯泡", "banner区") | not)) else . end'
# @source TieBaAds
# S0022 | 首页搜索、进吧搜索
http-response-jq ^https?:\/\/tieba(c)?\.baidu\.com\/c\/f\/search\/discover 'if type == "object" and ((has("error_code") | not) or .error_code == 0 or .error_code == "0") and (.data | type) == "object" and (.data.discover_list | type) == "array" then .data.discover_list=[] else . end'
# S0024 | 侧边抽屉栏
http-response-jq ^https?:\/\/tieba(c)?\.baidu\.com\/c\/f\/sidebar\/home 'if type == "object" and ((has("error_code") | not) or .error_code == 0 or .error_code == "0") then del(.game_center, .tools, .vip_banner, .task_list) else . end'
# S0026 | 我的页面：保留原完整净化和功能区筛选
http-response-jq ^https?:\/\/tieba(c)?\.baidu\.com\/c\/u\/user\/profile 'if type == "object" and ((has("error_code") | not) or .error_code == 0 or .error_code == "0") and (.zone_info | type) == "array" and all(.zone_info[]; type == "object" and (.type | type) == "string") then del(.duxiaoman, .namoaixud, .namoaixud_entry, .recom_naws_list, .duxiaoman_entry, .vip_banner) | .zone_info |= map(select(.type == "common_func" or .type == "auxiliary_func")) else . end'
# S0028 | 进吧推荐搜索
http-response-jq ^https?:\/\/tieba(c)?\.baidu\.com\/c\/f\/forum\/forumGuide 'if type == "object" and ((has("error_code") | not) or .error_code == 0 or .error_code == "0") and (.hot_search | type) == "array" then .hot_search=[] else . end'
# S0030 | 搜索推荐
http-response-jq ^https?:\/\/tieba(c)?\.baidu\.com\/mo\/q\/search\/startPage 'if type == "object" and ((has("error_code") | not) or .error_code == 0 or .error_code == "0") then del(.data) else . end'

[Script]
# @source AmapAds
# S0028 | 请求阶段 AMDC
Amap-AMDC = type=http-request,pattern=^http:\/\/amdc\.m\.taobao\.com,script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/MoyuAds/js/amdc.js,timeout=5
# @source Applet
# S0035 | 掌上公交：仅精确属性和值
Applet-Bus = type=http-response,pattern=^https?:\/\/wx\.mygolbs\.com\/WxBusServer\/ApiData\.do,script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/MoyuAds/js/bus.js,requires-body=true,max-size=1048576,timeout=5
# S0037 | 通用 URL 谓词保留；仅下列枚举 MITM 主机可解密
Applet-Posts = type=http-response,pattern="^(https?://)?([a-zA-Z0-9]+(-[a-zA-Z0-9]+)*\.)+[a-zA-Z]{2,}(:\d+)?/wp-json/[a-zA-Z0-9_-]+/(mp\/)?v\d/posts",script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/MoyuAds/js/applet.js,requires-body=true,max-size=1048576,timeout=5
# @source CainiaoAds
# S0020 | 请求阶段 AMDC
Cainiao-AMDC = type=http-request,pattern=^http:\/\/amdc\.m\.taobao\.com,script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/MoyuAds/js/amdc.js,timeout=5
# @source CheLaiLeAds
# S0032 | YGKJ 底栏：保留包装、原始字节与数字精度
CheLaiLe-City = type=http-response,pattern=^https?:\/\/.*chelaile\.net\.cn\/goocity\/city!,script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/MoyuAds/js/chelaile.js,requires-body=true,max-size=1048576,timeout=5
# @source GoofishAds
# S0051 | AMDC：请求阶段短路，保留全部原 UA 分支
Goofish-AMDC = type=http-request,pattern="^http:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,4}(:\d+)?\/amdc\/mobileDispatch",script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/MoyuAds/js/amdc.js,timeout=5
# @source TieBaAds
# S0034 | 仅源配置激活的 protobuf 分支；默认保留普通视频帖子
TieBa-Proto = type=http-response,pattern=^http(s:\/\/tiebac|:\/\/c\.tieba)\.baidu\.com\/c\/f\/(frs\/(page|threadlist|generalTabList)|pb\/page|excellent\/personalized)\?cmd,requires-body=true,binary-body-mode=true,max-size=1048576,timeout=5,script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/MoyuAds/js/tieba-proto.js

