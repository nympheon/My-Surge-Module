#!name=kelee-HTTPDNS
#!desc=拦截应用内置 HTTPDNS，保留原规则中的嘀嗒出行例外；使用 Surge 原生规则和 Map Local。
#!author=可莉、VirgilClyne；Surge 手工整理

# 原始来源：https://kelee.one/Tool/Loon/Lpx/Block_HTTPDNS.lpx
# 核对镜像：bunizao/Mirrored，a8e1cbf97a2298a5f64412fcd1c6deb11d5de4f6
# 兼容 Surge Mac / iPhone / iPad。与去广告集合一同启用。

[Rule]
# 嘀嗒出行原有例外：只放行这两个 HTTP 接口与对应 User-Agent 的组合。
AND,((URL-REGEX,^http://119\.(?:29\.29|28\.28)\.90/d\?),(USER-AGENT,%E5%98%80%E5%97%92%E5%87%BA%E8%A1%8C*)),DIRECT

# 通用 HTTPDNS 域名与客户端标识；下方只保留未被关键词覆盖的精确域名。
DOMAIN-KEYWORD,httpdns,REJECT
DOMAIN-KEYWORD,httpsdns,REJECT
USER-AGENT,httpdns*,REJECT
USER-AGENT,httpsdns*,REJECT
USER-AGENT,Httpdns*,REJECT
USER-AGENT,Httpsdns*,REJECT

# 通过 IP 地址直接发起的 HTTPDNS 请求。
URL-REGEX,^http://((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:/v?[0-9]+)?/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?,REJECT
URL-REGEX,^http://\[[0-9a-fA-F:]+\](?:/v?[0-9]+)?/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?,REJECT
URL-REGEX,^http://103\.44\.58\.64/md\?,REJECT
URL-REGEX,^http://cdn\.wup\.huya\.com/launch/queryHttpDns,REJECT
# 保留原插件对喜马拉雅此接口的处理范围。
URL-REGEX,^http://xmc\.ximalaya\.com/xmlymain-login-web/login/,REJECT
URL-REGEX,^http://(?:amdc\.m\.taobao\.com|47\.246\.103\.(?:9|10)|59\.82\.113\.(?:10|219))/amdc/mobileDispatch,REJECT
URL-REGEX,^http://103\.37\.155\.60/fetch,REJECT
URL-REGEX,^http://api\.weibo\.cn/(?:\d+/)?httpdns/config,REJECT
URL-REGEX,^http://((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)/v\d/resolv\?,REJECT
URL-REGEX,^http://((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?):\d+/httpdns/,REJECT
URL-REGEX,^http://\[[0-9a-fA-F:]+\]:\d+/httpdns/,REJECT

# 各应用未使用 httpdns / httpsdns 命名的解析、调度服务。
DOMAIN,dns2.q2cdn.com,REJECT
DOMAIN,dns.weixin.qq.com,REJECT
DOMAIN,dns.weixin.qq.com.cn,REJECT
DOMAIN,aedns.weixin.qq.com,REJECT
DOMAIN,resolver.msg.xiaomi.net,REJECT
DOMAIN,amdc.alipay.com,REJECT
DOMAIN,ucdc.upaas.quark.cn,REJECT
DOMAIN,xpis-xcdn.youku.com,REJECT
DOMAIN,pre-xpis-xcdn.youku.com,REJECT
DOMAIN,xpis-tel-xcdn.youku.com,REJECT
DOMAIN,xpis-mob-xcdn.youku.com,REJECT
DOMAIN,doh.ptqy.gitv.tv,REJECT
DOMAIN,dns.iqiyi.com,REJECT
DOMAIN,doh.iqiyi.com,REJECT
DOMAIN,dns.qiyipic.iqiyi.com,REJECT
DOMAIN,dns.jd.com,REJECT
DOMAIN,dotserver.douyucdn.cn,REJECT
DOMAIN,hdns.ksyun.com,REJECT
DOMAIN,cdndns.kwd.inkuai.com,REJECT
DOMAIN,hdns.k-dyn.com,REJECT
DOMAIN,apidns.kwd.inkuai.com,REJECT
DOMAIN,apidns-js.kwd.inkuai.com,REJECT
DOMAIN,dns.weibo.cn,REJECT
DOMAIN,hd.xiaojukeji.com,REJECT
DOMAIN,serveraddr.service.kugou.com,REJECT
DOMAIN,twns.p2ptun.qq.com,REJECT
DOMAIN,tp2p.kg.qq.com,REJECT

# 原插件的 IPv4 / IPv6 地址列表；no-resolve 避免额外触发 DNS 查询。
IP-CIDR,39.156.140.30/32,REJECT,no-resolve
