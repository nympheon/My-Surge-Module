[Map Local]
# 网易邮箱大师：返回空 JSON。
(?i)^https?://appconf\.mail\.163\.com/mailmaster/api/http/urlConfig\.do$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 虎牙与喜马拉雅：保留原插件的 404 响应。
(?i)^https?://cdn\.wup\.huya\.com/monitor/monitor\.jsp data-type=text data="" status-code=404
(?i)^https://gslbali\.ximalaya\.com/linkeye-cloud/httpdns/ data-type=text data="" status-code=404
# 健康160、UC 与他趣：返回空 JSON。
(?i)^https://msglb\.91160\.com/msg/outer/broker/get$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://ucdc\d?-upaas\.uc\.cn/api/v\d/dns_query\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gw-cn\.jiaoliuqu\.com/taqu-im-broadcast-srv/v\d/Comet/get\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
# 仅追加需要改写的 HTTPS 主机；补齐原镜像遗漏的虎牙、喜马拉雅及 UC 主机。
hostname = %APPEND% appconf.mail.163.com, cdn.wup.huya.com, gslbali.ximalaya.com, msglb.91160.com, ucdc-upaas.uc.cn, ucdc0-upaas.uc.cn, ucdc1-upaas.uc.cn, ucdc2-upaas.uc.cn, ucdc3-upaas.uc.cn, ucdc4-upaas.uc.cn, ucdc5-upaas.uc.cn, ucdc6-upaas.uc.cn, ucdc7-upaas.uc.cn, ucdc8-upaas.uc.cn, ucdc9-upaas.uc.cn, gw-cn.jiaoliuqu.com
