#!name=墨迹天气净化 · Surge 原生版
#!desc=保留完整上游净化：我的页、视频、时景发现与关注、推广、开屏；Surge Mac 5.9.0+ / iOS 5.14.0+。
#!author=nympheon；上游 ddgksf2013
#!homepage=https://github.com/nympheon/My-Surge-Module
#!category=去广告
#!date=2026-10-31
# Source: https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/MoJiWeatherAds.conf
# Frozen source: references/moyu-independent/MoJiWeatherAds.conf (2026-10-31).
# Sxxxx identifies the physical source line. All original predicates are retained verbatim.

[Rule]
# S0035 | 开屏广告域名
DOMAIN-SUFFIX,adlaunch.moji.com,REJECT

[Body Rewrite]
# S0021 | 我的页面移除工具区、我页面灯泡、banner区
http-response-jq ^https?:\/\/.*api\.moji\.com\/json\/entrance\/list 'if type == "object" and (.entrance_region_res_list | type) == "array" and all(.entrance_region_res_list[]; type == "object" and (.region_name | type) == "string") then .entrance_region_res_list |= map(select(.region_name | IN("工具区", "我页面灯泡", "banner区") | not)) else . end'

[Map Local]
# S0023 | 首页浮窗：原 reject-200 的空 200 文本响应
^https?:\/\/.*api\.moji\.com\/flycard\/flyCard data-type=text data=""
# S0025 | 首页底部短视频
^https?:\/\/.*api\.moji\.com\/shortvideo data-type=text data=""
# S0027 | 商品推广
^https?:\/\/.*api\.moji\.com\/json\/advertising_goods data-type=text data=""
# S0029 | 时景发现
^https?:\/\/.*api\.moji\.com\/forum data-type=text data=""
# S0031 | 时景关注
^https?:\/\/.*api\.moji\.com\/user\/dynamic_v\d\/json\/someone_interest data-type=text data=""
# S0033 | DNS 配置
^https:\/\/tnc.*zijieapi\.com\/get_domains data-type=text data=""

[MITM]
hostname = %APPEND% *.api.moji.com, tnc*-*.zijieapi.com
