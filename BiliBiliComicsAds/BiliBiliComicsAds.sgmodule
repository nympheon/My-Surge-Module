#!name=哔哩哔哩漫画净化 · Surge 原生版
#!desc=保留完整上游净化：开屏、运营位、搜索推荐、活动、我的页；Surge Mac 5.9.0+ / iOS 5.14.0+。
#!author=nympheon；上游 ddgksf2013
#!homepage=https://github.com/nympheon/My-Surge-Module
#!category=去广告
#!date=2026-10-31
# Source: https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/BiliBiliComicsAds.conf
# Frozen source: references/moyu-independent/BiliBiliComicsAds.conf (2026-10-31).
# Sxxxx identifies the physical source line. Hand-authored; unknown/error shapes pass through.
# Bili envelope: absent code or numeric code=0 is supported; explicit non-success code passes through.

[Body Rewrite]
# S0023 | 开屏与活动弹窗
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.list | type) == "array" then .data.list=[] | .data.ad_list=[] | .data.show=[] | .data.verifying_list=[] | .data.ad_loc=false else . end'
# S0026 | 首页轮播
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Banner 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "array" then .data=[] else . end'
# S0029 | 初始化：保留全部上游字段净化，包括商城、游戏与消息计数
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/AppInit 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.flash | type) == "object" and (.data.operate | type) == "object" then .data.flash={"id":0,"title":"","img":"","jump_type":0,"jump_value":"","offline_time":"","meta_type":0,"video":"","online_time":"","button":"","video_hash":"","button_type":0,"click_type":0,"show_limit":0,"txt_type":0,"back_img":"","flow_id":""} | .data.operate={"id":0,"title":"","img":"","jump_url":"","gift_type":0,"gift_comic_id":0,"gift_url":"","has_taken_gift":false,"jump_type":0,"img_type":0,"md5":"","play_mode":0} | .data.user_center_operate=null | .data.activity_tab=null | .data.bubble=null | .data.card_banner_in_pay=null | .data.card_banner_in_ctrl={"id":0,"img_url":""} | .data.card_banner_in_coupon=null | .data.fission={"enable_entry":false,"title":"","subtitle":"","url":""} | .data.shop_entry=false | .data.shop_entry_txt="" | .data.shop_entry_icon="" | .data.game_entry=false | .data.game_entry_txt="" | .data.game_entry_desc="" | .data.game_entry_url="" | .data.game_entry_icon="" | .data.act_entry_txt="" | .data.act_entry_txt_type=0 | .data.unread_message_count=0 else . end'
# S0032 | 活动 Tab 与商城入口
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetClassPageAllTabs 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.home_type | type) == "array" and (.data.home_feed | type) == "array" and all(.data.home_type[]; type == "object" and (.name | type) == "string") and all(.data.home_feed[]; type == "object" and (.name | type) == "string") then .data.home_type |= map(select(.name!="初夏纯爱！" and .name!="妖气村")) | .data.home_feed |= map(select(.name!="商城")) else . end'
# S0035 | 推荐运营卡片与签到横幅
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Home\/HomeFeed 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.feeds | type) == "array" and (.data.banner | type) == "object" and all(.data.feeds[]; type == "object" and (.type | type) == "number") then .data.feeds |= map(select(.type!=42)) | .data.banner.image="" | .data.banner.jump_url="" | .data.banner.text="" | .data.banner.remain_sign_days=0 else . end'
# S0038 | 活动 Tab
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetActivityTab 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data | has("name")) then .data.name="" | .data.img="" | .data.url="" | .data.gif="" | .data.cycle_num=0 | .data.bubble_txt="" | .data.id=0 else . end'
# S0041 | 气泡
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetBubbles 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.bubbles | type) == "array" then .data.bubbles=[] | .data.rule=null else . end'
# S0044 | 福利横幅
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetWelfareBanner 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data | has("type")) and (.data | has("title")) then .data.type=0 | .data.title="" | .data.sub_title="" | .data.content="" | .data.jump_url="" else . end'
# S0047 | 运营横幅；保留上游 Operater 拼写
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetOperaterBanner 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.operate | type) == "object" then .data.operate={"id":0,"title":"","img":"","jump_url":"","gift_type":0,"gift_comic_id":0,"gift_url":"","has_taken_gift":false,"jump_type":0,"img_type":0,"md5":"","play_mode":0} else . end'
# S0050 | 通用横幅与畅读卡营销
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetCommonBanner 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data | has("id")) and (.data | has("title")) then .data.id=0 | .data.title="" | .data.content="" | .data.jump_url="" | .data.jump_type=0 | .data.background="" | .data.image_url="" | .data.comic_id=0 | .data.icon="" | .data.type=0 | .data.column=null | .data.limit_scope=0 | .data.btn_txt="" | .data.img_type=0 | .data.play_mode=0 | .data.color_type=0 | .data.sub_background="" | .data.relate_second_page=false | .data.active_time="" | .data.offline_time="" | .data.create_time="" | .data.status=0 | .data.banner_ext=null | .data.bubble_text="" | .data.calendar_ext=null else . end'
# S0053 | Hook 横幅
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetHookBanner 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data | has("id")) and (.data | has("title")) then .data.id=0 | .data.title="" | .data.jump_url="" | .data.image_url="" else . end'
# S0056 | 我的页仅保留我的已购
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.User\/UCenterConf 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.confs | type) == "array" and all(.data.confs[]; type == "object" and (.title | type) == "string") then .data.confs |= map(select(.title=="我的已购")) | .data.show_welfare=false | .data.show_all_welfare=false else . end'
# S0059 | 营销中心入口与弹窗
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.User\/GetMarketingCenterInfo 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.entry | type) == "object" and (.data.popup | type) == "object" then .data.show_entry=false | .data.entry.image="" | .data.entry.url="" | .data.entry.entry_id="0" | .data.show_popup=false | .data.popup.image="" | .data.popup.url="" | .data.popup.activity_id="0" | .data.popup.entry_id="0" else . end'
# S0062 | 搜索填词
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/search\.v\d\.Search\/GetSearchBoxKeyword 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.keywords | type) == "array" then .data.keywords=[] else . end'
# S0065 | 搜索页展示
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/SearchDisplay 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.list | type) == "array" then .data.list=[] else . end'
# S0068 | 搜索页横幅
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/SearchBanner 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.banners | type) == "array" then .data.banners=[] else . end'
# S0071 | 猜你喜欢标签
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/search\.v\d\.Search\/GetGuessLabel 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.labels | type) == "array" then .data.labels=[] else . end'
# S0074 | 热搜
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/search\.v\d\.Search\/GetHotSearch 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.comics | type) == "array" then .data.comics=[] else . end'
# S0077 | 红点
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/line\.v\d\.Line\/TabRedDot 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "object" and (.data.has_red_dot | type) == "boolean" then .data.has_red_dot=false else . end'
# S0080 | 推荐
http-response-jq ^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Recommend 'if type == "object" and ((has("code") | not) or .code == 0) and (.data | type) == "array" then .data=[] else . end'

[MITM]
hostname = %APPEND% manga.bilibili.com
