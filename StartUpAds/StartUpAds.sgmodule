[Body Rewrite]
# S0052 | 123pan：仅禁用 HTML 中的广告开关，删除未启用的下载/UA 改写逻辑。
http-response ^https?://www\.123pan\.com/s/[0-9a-zA-Z=_/-]+\.html "IsShowAdvertisement\":true" "IsShowAdvertisement\":false"
# S0130 | crunchyroll
http-response https://beta-api.crunchyroll.com/cms "offset_ms\":\\d+" "offset_ms\":99999999999999"
# S0207 | dingdongmaicai
http-response ^https?://maicai\.api\.ddxq\.mobi/advert/getAd "rt_time\":\\d{2}" "rt_time\":40"
# S0245 | feikechaguan
http-response ^https?://.*flyert.*/api/mobile/index\.php\?version=\d&mobile=yes&module=basicdata&type=forumlist adv ddgksf2013
# S0339 | iQiYi：原生删除广告位，其他响应字段保留。
http-response-jq ^https?://.*cupid\.iqiyi\.com/mixer\? 'if type == "object" then del(.adSlots) else . end'
# S0352 | jingxi：原生修改广告展示时间，保留 materialList 中的其他字段。
http-response-jq ^https?://api\.m\.jd\.com/api\?functionId=delivery_show 'if type == "object" and (.data | type) == "object" and (.data.materialList | type) == "object" then .data.materialList.startTime = 3667476800000 | .data.materialList.endTime = 3667908800000 else . end'
# S0360 | jingdonglite
http-response ^https?://api\.m\.jd\.com/client\.action\?functionId=lite_advertising jdLiteAdvertisingVO ddgksf2013
# S0361 | jingdonglite
http-response ^https?://api\.m\.jd\.com/client\.action\?functionId=lite_SmartPush pushData ddgksf2013
# S0404 | kfc
http-response ^https?://res.kfc.com.cn/CRM/kfcad/apphome6/apphome.*json bootStrapAd ddgksf2013
# S0418 | kuake：仅删除 result 中含 cms_ 的键，保留其他返回内容。
http-response-jq ^https?://open-cms-api\.(uc|quark)\.cn/open-cms 'if type == "object" and (.result | type) == "object" then .result |= with_entries(select(.key | contains("cms_") | not)) else . end'
# S0439 | koudaijizhang：未知数据结构放行。
http-response-jq ^https?://api\.qeeniao\.com/nap/ad 'if type == "object" and (.data | type) == "object" then .data = {} else . end'
# S0504 | manmanmai
http-response ^https?://apapia-sqk\.manmanbuy\.com/index_json\.ashx splashAD ddgksf2013
# S0585 | ocleancare
http-response ^https?://careapi\.oclean\.com/mall/v\d/User/GetUserCenter "banner\"" "ddgksf2013\""
# S0600 | pupumarket
http-response ^https?://j1\.pupuapi\.com/client/marketing/advertisement/v "launch_time_close\":\\d+" "launch_time_close\":1660716799999"
# S0637 | qidianyuedu：仅重置原本 truthy 的三个广告字段。
http-response-jq ^https?://apps\.teamair\.cn/app/version 'if type == "object" and (.data | type) == "object" then .data |= with_entries(if (.key == "ads2" or .key == "adSource2" or .key == "third") and (.value != null and .value != false and .value != 0 and .value != "") then .value = {} else . end) else . end'
# S0683 | shihuo
http-response ^https?://sh-gateway\.shihuo\.cn/v\d/services/sh-adapi/home/screen "egin_time\":\"\\d{4}" "egin_time\":\"2099"
# S0716 | tianfutong
http-response ^https?://tft-app\.cdtft\.cn/gateway-customer/tftapp/tft-ams/api/appAd officialAdvertResultVo ddgksf2013
# S0764 | tianmaojingling：仅过滤名称含“营销”的子项，未知子项保留。
http-response-jq ^https?://acs\.m\.taobao\.com/gw/mtop\.alibaba.*mytab 'if type == "object" and (.data | type) == "object" and (.data.model | type) == "object" and (.data.model.children | type) == "array" then .data.model.children |= map(select((if type == "object" and (.name | type) == "string" then .name | contains("营销") else false end) | not)) else . end'
# S0799 | WeChat：保留上游字段改名；当前公众号接口效果未实机验收。
http-response ^https?://mp\.weixin\.qq\.com/mp/getappmsgad advertisement ddgksf2013
