# S0879 | xiaoxiong
http-response ^https?://apps\.workair\.cn/app/version "ads\"" "ddgksf2013\""
# S0902 | xiaocanhuishenghuo
http-response ^https://gw\.xiaocantech\.com/rpc "\"vip_pop_up\":0" "\"vip_pop_up\":2"

[Script]
# 每份脚本均为本仓库的明文 Surge 实现；请求头判别不申请正文。
# S0044 | 555
Startup_555 = type=http-response, pattern="^https?://[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,4}(:\d+)?/api/v\d/movie/index_recommend", requires-body=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/StartUpAds/js/555Ad.js
# S0061 | 12306：读取请求 placementNo，返回原生 response 对象。
Startup_12306 = type=http-request, pattern=^https?://ad\.12306\.cn/ad/ser/getAdList, requires-body=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/StartUpAds/js/12306.js
# S0076 | AMDC：按 UA 判断，在请求阶段生成原上游的文本响应。
Startup_AMDC = type=http-request, pattern="^http://[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,4}(:\d+)?/amdc/mobileDispatch", requires-body=false, timeout=5, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/StartUpAds/js/amdc.js
# S0078 | ahfs
Startup_AHFS = type=http-response, pattern=^https?://.*(xbwpys|ahhhhfs)\.com/($|[0-9a-zA-Z_/]+/$), requires-body=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/StartUpAds/js/ahfs.js
# S0088 | 百度地图：带帧头、校验和的二进制 protobuf，必须启用二进制正文。
Startup_BaiduMap = type=http-response, pattern=^https://newclient\.map\.baidu\.com/client/phpui2/\?qt=ads, requires-body=true, binary-body-mode=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/StartUpAds/js/baidumap.js
# S0122 | baishitv
Startup_BesTV = type=http-response, pattern=^https?://bp-api\.bestv\.com\.cn/cms/api/audit/home/getCommonMixData, requires-body=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/StartUpAds/js/baishitv.js
# S0149 | caixin：保留日期修改，修正多位 intval 导致非法 JSON 的上游缺陷。
Startup_Caixin = type=http-response, pattern=^https?://gg\.caixin\.com/s\?z=caixin&op=1&c=3362, requires-body=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/StartUpAds/js/caixinads.js
# S0246 | feikechaguan
Startup_Flyer = type=http-response, pattern=^https?://.*flyert.*/source/plugin/mobile/mobile\.php\?module=threadpost&.+?&page=1, requires-body=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/StartUpAds/js/fly.js
# S0303 | 航旅纵横：仅广告 rpid；其他操作放行。
Startup_Umetrip = type=http-request, pattern=^https?://.*umetrip\.com\.cn/gateway/api/umetrip/native$, requires-body=false, timeout=5, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/StartUpAds/js/hanglvzongheng.js
# S0343 | ithome
Startup_ITHome = type=http-response, pattern=^https?://napi\.ithome\.com/api/news/indexv\d/iphone, requires-body=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/StartUpAds/js/ithome.js
# S0356 | jingdong 搜索
Startup_JDSearch = type=http-response, pattern=^https?://api\.m\.jd\.com/client\.action\?functionId=(hotWords|hotSearchTerms), requires-body=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/StartUpAds/js/jd_json.js
# S0409 | 酷安内容
Startup_Coolapk = type=http-response, pattern=^https?://api\.coolapk\.com/v6/(feed/(replyList|detail)|main/indexV8|dataList), requires-body=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/StartUpAds/js/coolapk.js
# S0410 | 酷安初始化
Startup_CoolapkInit = type=http-response, pattern=^https?://api.coolapk.com/v6/main/init, requires-body=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/StartUpAds/js/coolapk.js
