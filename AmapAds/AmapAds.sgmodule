#!name=高德地图净化 · Surge 原生版
#!desc=完整净化首页、附近、我的、搜索和推广；Surge Mac 5.9.0+ / iOS 5.14.0+。
#!author=nympheon；上游 ddgksf2013
#!homepage=https://github.com/nympheon/My-Surge-Module
#!category=去广告
# Source: ddgksf2013/Rewrite/AdBlock/AmapAds.conf; frozen 2026-10-31.

[Rule]
# S0020 | 保留原直连例外
DOMAIN-SUFFIX,optimus-ads.amap.com,DIRECT

[URL Rewrite]
# S0044 | 通用广告
^https?:\/\/.*\.amap\.com\/ws\/asa\/ads_attribution - reject

[Map Local]
# S0024 | 开屏空 200
^https?:\/\/.*\.amap\.com\/ws\/aos\/alimama\/splash_screen data-type=text data=""
# S0026 | 首页信息流空字典
^https?:\/\/.*\.amap\.com\/v\d\/ai_rec\/ data-type=text data="{}" header="Content-Type:application/json"
# S0032 | 路线规划空字典
^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/card-service-route-plan\? data-type=text data="{}" header="Content-Type:application/json"
# S0040 | Tip 空 200
^https?:\/\/.*\.amap\.com\/ws\/boss\/order_web\/\w{8}_information data-type=text data=""
# S0054 | 搜索场景空字典
^https?:\/\/.*\.amap\.com\/ws\/shield\/scene\/recommend data-type=text data="{}" header="Content-Type:application/json"
# S0056 | 透明图片
^https?:\/\/.*\.amap\.com\/uploadimg\/\w+\.gif data-type=tiny-gif
# S0058 | 天气空字典
^https?:\/\/.*\.amap\.com\/ws\/valueadded\/weather data-type=text data="{}" header="Content-Type:application/json"

[Body Rewrite]
# S0030 | 底栏角标
http-response-jq ^https?:\/\/.*\.amap\.com\/ws\/message\/notice\/list '. as $original | try (def ok: type=="object" and ([.error,.errorMessage]|all(.==null or .==false or .=="")) and ((.status=="0" and has("infocode"))|not); if ok and (.data|type)=="object" and .data.noticeList!=null and .data.noticeList!=false and .data.noticeList!=0 and .data.noticeList!="" then .data.noticeList=[] else . end) catch $original'
# S0034 | 运营配置、AI 和角标
http-response-jq ^https?:\/\/.*\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable '. as $original | try (def ok: type=="object" and ([.error,.errorMessage]|all(.==null or .==false or .=="")) and ((.status=="0" and has("infocode"))|not); if ok and (.data|type)=="object" then .data |= with_entries(if .key|test("gd_notch_logo|home_business_position_config|his_input_tip|operation_layer|aiNative|ai_|_ai") then .value={status:1,version:"",value:""} else . end) else . end) catch $original'
# S0036 | 附近完整净化
http-response-jq ^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/nearbyrec_smart '. as $original | try (def ok: type=="object" and ([.error,.errorMessage]|all(.==null or .==false or .=="")) and ((.status=="0" and has("infocode"))|not); if ok and (.data|type)=="object" and ((.data|has("modules")|not) or .data.modules==null or .data.modules==false or .data.modules==0 or .data.modules=="" or ((.data.modules|type)=="array" and all(.data.modules[];type=="string"))) then del(.data.coupon,.data.scene,.data.activity,.data.commodity_rec,.data.operation_activity) | if (.data.modules|type)=="array" then .data.modules |= map(select(.!="coupon" and .!="scene" and .!="activity" and .!="commodity_rec" and .!="operation_activity")) else . end else . end) catch $original'
# S0038 | 打车资源；保留原 JS falsy 条件
http-response-jq ^https?:\/\/.*\.amap\.com\/ws\/promotion-web\/resource '. as $original | try (def ok: type=="object" and ([.error,.errorMessage]|all(.==null or .==false or .=="")) and ((.status=="0" and has("infocode"))|not); if ok and (.data|type)=="object" then .data |= with_entries(if (.key=="icon" or .key=="banner" or .key=="tips" or .key=="popup" or .key=="bubble" or .key=="other") and .value!=null and .value!=false and .value!=0 and .value!="" then .value=[] else . end) else . end) catch $original'
# S0042 | 首页只保留登录卡、常用位置；Object.values 数字键排序
http-response-jq ^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/main-page '. as $original | try (def ok: type=="object" and ([.error,.errorMessage]|all(.==null or .==false or .=="")) and ((.status=="0" and has("infocode"))|not); def vals: if type=="array" then . else to_entries|sort_by(if (.key|test("^(0|[1-9][0-9]*)$")) and (.key|tonumber)<4294967295 then [0,(.key|tonumber)] else [1,0] end)|map(.value) end; if ok and (.data|type)=="object" and ((.data.cardList==null or .data.cardList==false or .data.cardList==0 or .data.cardList=="") or ((.data.cardList|type)=="array" or (.data.cardList|type)=="object") and all(.data.cardList[];type=="object" and (.dataType|type)=="string")) then .data |= (if .cardList!=null and .cardList!=false and .cardList!=0 and .cardList!="" then .cardList |= (vals|map(select(.dataType=="LoginCard" or .dataType=="FrequentLocation"))) else . end | if .mapBizList!=null and .mapBizList!=false and .mapBizList!=0 and .mapBizList!="" then .mapBizList=[] else . end | if .business_position!=null and .business_position!=false and .business_position!=0 and .business_position!="" then .business_position=[] else . end | if (.pull3|type)=="object" and .pull3.msgs!=null and .pull3.msgs!=false and .pull3.msgs!=0 and .pull3.msgs!="" then .pull3.msgs=[] else . end) else . end) catch $original'
# S0046 | 开屏 creative 仅修改第一项；2240150400 为原常量
http-response-jq ^https?:\/\/.*\.amap\.com\/ws\/valueadded\/alimama\/splash_screen '. as $original | try (def ok: type=="object" and ([.error,.errorMessage]|all(.==null or .==false or .=="")) and ((.status=="0" and has("infocode"))|not); if ok and (.data|type)=="object" and (.data.ad|type)=="array" and all(.data.ad[];type=="object" and (.set.setting|type)=="object" and (.creative|type)=="array" and (.creative[0]|type)=="object") then .data.ad |= map(.set.setting.display_time=0 | .creative[0].start_time=2240150400 | .creative[0].end_time=2240150400) else . end) catch $original'
# S0048 | 首页顶部消息
http-response-jq ^https?:\/\/.*\.amap\.com\/ws\/msgbox\/pull '. as $original | try (def ok: type=="object" and ([.error,.errorMessage]|all(.==null or .==false or .=="")) and ((.status=="0" and has("infocode"))|not); if ok then (if .msgs!=null and .msgs!=false and .msgs!=0 and .msgs!="" then .msgs=[] else . end) | if (.pull3|type)=="object" and .pull3.msgs!=null and .pull3.msgs!=false and .pull3.msgs!=0 and .pull3.msgs!="" then .pull3.msgs=[] else . end else . end) catch $original'
# S0050 | 我的页只保留订单与高德推荐卡
http-response-jq ^https?:\/\/.*\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaas '. as $original | try (def ok: type=="object" and ([.error,.errorMessage]|all(.==null or .==false or .=="")) and ((.status=="0" and has("infocode"))|not); def vals: if type=="array" then . else to_entries|sort_by(if (.key|test("^(0|[1-9][0-9]*)$")) and (.key|tonumber)<4294967295 then [0,(.key|tonumber)] else [1,0] end)|map(.value) end; if ok and (.data|type)=="object" and ((.data.cardList==null or .data.cardList==false or .data.cardList==0 or .data.cardList=="") or ((.data.cardList|type)=="array" or (.data.cardList|type)=="object") and all(.data.cardList[];type=="object" and (.dataType|type)=="string")) then del(.data.tipData) | if .data.cardList!=null and .data.cardList!=false and .data.cardList!=0 and .data.cardList!="" then .data.cardList |= (vals|map(select(.dataType=="MyOrderCard" or .dataType=="GdRecommendCard"))) else . end else . end) catch $original'
# S0052 | 搜索热词
http-response-jq ^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/new_hotword '. as $original | try (def ok: type=="object" and ([.error,.errorMessage]|all(.==null or .==false or .=="")) and ((.status=="0" and has("infocode"))|not); if ok and (.data|type)=="object" and .data.header_hotword!=null and .data.header_hotword!=false and .data.header_hotword!=0 and .data.header_hotword!="" then .data.header_hotword=[] else . end) catch $original'

[Script]
# S0028 | 请求阶段 AMDC
Amap-AMDC = type=http-request,pattern=^http:\/\/amdc\.m\.taobao\.com,script-path=https://raw.githubusercontent.com/nympheon/My-Surge-Module/main/AmapAds/js/amdc.js,timeout=5

[MITM]
hostname = %APPEND% m5.amap.com, m5-zb.amap.com, center.amap.com, amap-aos-info-nogw.amap.com, ai.amap.com
